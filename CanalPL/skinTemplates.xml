<?xml version="1.0" encoding="UTF-8"?>
<!-- Native OpenATV template: 8 rows in the 704px list, independent of Legacy row count. -->
<templates>
  <template name="CanalPL" component="serviceList" fonts="CanalText;32,CanalText;25,CanalText;24">
    <mode name="services" itemHeight="88" itemWidth="1088" foregroundColor="white" foregroundColorSelected="white" backgroundColor="bg" backgroundColorSelected="selected">
      <rectangle position="0,0" size="4,88" foregroundColor="bg" foregroundColorSelected="green" />
      <rectangle position="8,87" size="1080,1" foregroundColor="line" foregroundColorSelected="selected" />
      <text index="Number" position="16,0" size="52,88" font="2" halign="right" valign="center" foregroundColor="muted" foregroundColorSelected="green" />
      <pixmap index="Picon" position="88,12" size="112,64" alpha="blend" scaleFlags="scaleCenter" />
      <text index="ServiceName" position="236,8" size="828,40" font="0" valign="center" />
      <text index="Title1" position="236,52" size="828,30" font="1" foregroundColor="muted" foregroundColorSelected="white" />
    </mode>
    <mode name="bouquets" itemHeight="88" itemWidth="1088" foregroundColor="white" foregroundColorSelected="white" backgroundColor="bg" backgroundColorSelected="selected">
      <rectangle position="0,0" size="4,88" foregroundColor="bg" foregroundColorSelected="green" />
      <text index="Number" position="16,0" size="52,88" font="2" halign="right" valign="center" foregroundColor="muted" foregroundColorSelected="green" />
      <text index="ServiceName" position="104,0" size="960,88" font="0" valign="center" />
    </mode>
    <mode name="other" itemHeight="88" itemWidth="1088" foregroundColor="white" foregroundColorSelected="white" backgroundColor="bg" backgroundColorSelected="selected">
      <rectangle position="0,0" size="4,88" foregroundColor="bg" foregroundColorSelected="green" />
      <text index="EntryName" position="24,0" size="1040,88" font="0" valign="center" />
    </mode>
  </template>
</templates>
